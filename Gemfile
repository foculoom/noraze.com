source "https://rubygems.org"

# Pin github-pages to match GitHub Pages' deployment target (v232 as of
# 2025-08-13; see https://pages.github.com/versions/). This bundles Jekyll
# 3.10.0, minima 2.5.1, jekyll-feed, jekyll-seo-tag, and all other Pages
# plugins at the exact versions GitHub builds with. Local `bundle exec
# jekyll serve` then reproduces the live build, so visual validation
# targets the real rendered output, not a fixture.
gem "github-pages", "232"