# Jekyll build output (generated by `jekyll serve` / `jekyll build`)
_site/
.jekyll-cache/
.jekyll-metadata

# Bundler lockfile is environment-specific (Docker build uses bundler 2.5.11;
# host Ruby 2.6 lacks it). The Gemfile pins github-pages 232, which is enough
# for reproducibility across the Docker build used for visual validation.
Gemfile.lock.sass-cache/
